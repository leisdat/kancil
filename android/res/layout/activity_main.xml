<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp"
        android:gravity="center_vertical"
        android:background="#FDFCF8">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Kembali" />

        <ImageButton
            android:id="@+id/btn_fwd"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_forward"
            android:contentDescription="Maju" />

        <EditText
            android:id="@+id/url_bar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/url_bg"
            android:hint="Cari atau ketik URL"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:textSize="14sp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:drawablePadding="8dp" />

        <Button
            android:id="@+id/btn_tabs"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:text="▣ 1"
            android:textSize="14sp"
            android:textColor="#0E5C43"
            android:contentDescription="1 tab" />

        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="Menu" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#C6A15B"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/web_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/error_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone"
            android:background="?android:attr/colorBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Halaman tidak dapat dimuat"
                android:fontFamily="serif"
                android:textSize="20sp"
                android:letterSpacing="0.02"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/error_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:gravity="center"
                android:paddingBottom="24dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Coba lagi" />

                <Button
                    android:id="@+id/btn_error_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="Kembali" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/pill_bg"
            android:elevation="4dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <View
                android:id="@+id/agent_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="#1EA446" />

            <TextView
                android:id="@+id/agent_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="● Agent aktif"
                android:textSize="11sp"
                android:letterSpacing="0.06"
                android:textColor="#EDE8DC" />
        </LinearLayout>

        <TextView
            android:id="@+id/agent_toast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/toast_bg"
            android:textColor="#E8EAED"
            android:textSize="11sp"
            android:padding="10dp"
            android:visibility="gone"
            android:fontFamily="monospace" />
    </FrameLayout>
</LinearLayout>
